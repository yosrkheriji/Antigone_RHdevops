# Copier en .env (jamais commite) pour `docker compose up`.
# Toutes les cles sont optionnelles : sans elles la pile demarre,
# seules les fonctions concernees (mail, IA, Google Drive) sont inactives.

DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=change-me-local-docker-secret-at-least-32-chars

MAIL_USERNAME=
MAIL_PASSWORD=
BREVO_API_KEY=

# Assistant IA : sans cle, /api/v1/** repond 503 et le reste fonctionne.
OPENAI_API_KEY=

# Comptes de service Google Drive, encodes en base64.
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_B64=
GOOGLE_DRIVE_VIEWER_KEY_B64=

# Liens d'integration Power BI de l'app RH (optionnels, pris en compte au build).
VITE_POWERBI_PRESENCE_URL=
VITE_POWERBI_FINANCE_URL=
VITE_POWERBI_PROJETS_URL=

# Images a lancer (par defaut : construites localement).
# Pour utiliser celles publiees par la CI :
#   IMAGE_PREFIX=ghcr.io/yosrkheriji/antigone
#   IMAGE_TAG=latest
IMAGE_PREFIX=antigone
IMAGE_TAG=local
